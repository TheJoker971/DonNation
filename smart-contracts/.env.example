# Base Sepolia (chain id 84532)
#
# ❌ Arbitrum Sepolia ≠ Base Sepolia (URLs et chain id différents)
#    Arbitrum Sepolia → chain id 421614
#    Base Sepolia     → chain id 84532
#
# RPC public (limité, OK pour débuter) :
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
#
# RPC dédié (recommandé) — nouvelle app sur le réseau "Base Sepolia" :
# Alchemy  : https://dashboard.alchemy.com
# Infura   : https://infura.io
# Exemple  : https://base-sepolia.g.alchemy.com/v2/VOTRE_CLE

# Clé privée du wallet de déploiement (hex, sans préfixe 0x)
PRIVATE_KEY=

# Optionnel : adresse d’un DonNationProtocol déjà déployé (sinon déploiement automatique)
# DON_NATION_PROTOCOL_ADDRESS=0x...

# Optionnel : FidelityCard1155 déjà déployé
# FIDELITY_CARD_ADDRESS=0x...
