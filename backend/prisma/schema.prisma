generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  WALLET
}

enum Role {
  ADMIN
  ASSOCIATION
  DONOR
}

enum AssociationStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum DonationStatus {
  PENDING
  PAID
  MINTING
  COMPLETED
  FAILED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  MINTED
  FAILED
}

model User {
  id                         String       @id @default(uuid())
  email                      String       @unique
  passwordHash               String?
  role                       Role         @default(DONOR)
  authProvider               AuthProvider @default(EMAIL) @map("auth_provider")
  googleId                   String?      @unique @map("google_id")
  walletAddress              String?      @unique @map("wallet_address")
  walletPrivateKeyEncrypted  String?      @map("wallet_private_key_encrypted")
  walletAuthNonce            String?      @map("wallet_auth_nonce")
  walletAuthNonceExpiresAt   DateTime?    @map("wallet_auth_nonce_expires_at")
  passwordResetTokenHash     String?      @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime?    @map("password_reset_expires_at")
  displayName                String?      @map("display_name")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")

  association          Association?
  approvedAssociations Association[] @relation("ApprovedBy")
  donations            Donation[]

  @@map("users")
}

model Association {
  id                       String            @id @default(uuid())
  ownerId                  String            @unique @map("owner_id")
  owner                    User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                     String
  slug                     String            @unique
  description              String?
  logoUrl                  String?           @map("logo_url")
  status                   AssociationStatus @default(PENDING)
  stripeConnectAccountId     String?           @unique @map("stripe_connect_account_id")
  stripeOnboardingComplete   Boolean           @default(false) @map("stripe_onboarding_complete")
  stripeCryptoPaymentsActive Boolean           @default(false) @map("stripe_crypto_payments_active")
  onChainRegistered        Boolean           @default(false) @map("on_chain_registered")
  approvedAt               DateTime?         @map("approved_at")
  approvedById             String?           @map("approved_by_id")
  approvedBy               User?             @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")
  donations                Donation[]
  photos                   AssociationPhoto[]

  @@map("associations")
}

model AssociationPhoto {
  id            String      @id @default(uuid())
  associationId String      @map("association_id")
  association   Association @relation(fields: [associationId], references: [id], onDelete: Cascade)
  url           String
  caption       String?
  order         Int         @default(0)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@map("association_photos")
}

model Donation {
  id                    String         @id @default(uuid())
  donorId               String         @map("donor_id")
  donor                 User           @relation(fields: [donorId], references: [id])
  associationId         String         @map("association_id")
  association           Association    @relation(fields: [associationId], references: [id])
  amountEur             Int            @map("amount_eur")
  pointsEarned          Int            @map("points_earned")
  isAnonymous           Boolean        @default(false) @map("is_anonymous")
  status                DonationStatus @default(PENDING)
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id")
  donorWallet           String?        @map("donor_wallet")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  invoice Invoice?

  @@index([associationId])
  @@index([donorId])
  @@map("donations")
}

model Invoice {
  id                    String        @id @default(uuid())
  donationId            String        @unique @map("donation_id")
  donation              Donation      @relation(fields: [donationId], references: [id], onDelete: Cascade)
  externalPaymentIdHash String?       @unique @map("external_payment_id_hash")
  receiptHash           String?       @map("receipt_hash")
  tokenId               Int?          @map("token_id")
  txHash                String?       @map("tx_hash")
  chainId               Int?          @map("chain_id")
  metadataUrl           String?       @map("metadata_url")
  pdfUrl                String?       @map("pdf_url")
  status                InvoiceStatus @default(PENDING)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("invoices")
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_events")
}
