# App
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database (Phase 2.3 — Prisma)
DATABASE_URL=postgresql://donnation:donnation@localhost:5433/donnation

# JWT (Phase 3)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h

# Admin bootstrap (prisma:seed — dev only, change in production)
ADMIN_EMAIL=admin@donnation.local
ADMIN_PASSWORD=change-me-admin

# Stripe Connect (Phase 6)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Activer les paiements USDC via Stripe Stablecoin Payments (Phase 2.1)
STRIPE_CRYPTO_PAYMENTS_ENABLED=true
APP_URL=http://localhost:3000
# Origines autorisées pour le frontend (séparer par des virgules si plusieurs)
CORS_ORIGIN=http://localhost:3000

# Blockchain Base Sepolia (Phase 7)
BASE_SEPOLIA_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
DON_NATION_PROTOCOL_ADDRESS=
CHAIN_ID=84532
# Wallet custodial si le donateur n'a pas encore de wallet (Privy V2)
BLOCKCHAIN_CUSTODIAL_WALLET=

# IPFS / storage (Phase 8)
PINATA_JWT=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
