# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database (Prisma — port 5433 aligné avec docker-compose backend/postgres)
DATABASE_URL=postgresql://donnation:donnation@localhost:5433/donnation

# JWT — générer en prod : openssl rand -base64 48
JWT_SECRET=<remplacer-par-openssl-rand-base64-48>
JWT_EXPIRES_IN=1h

# Admin bootstrap (prisma:seed — dev only)
ADMIN_EMAIL=admin@donnation.io
ADMIN_PASSWORD=<remplacer-avant-deploy>

# App URL (liens reset password, profil public asso)
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Google OAuth (donateurs — wallet custodial)
# Console : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Wallet custodial (AES-256-GCM) — générer : openssl rand -hex 32
WALLET_ENCRYPTION_KEY=<remplacer-par-openssl-rand-hex-32>

# Email — Resend (recommandé) ou SMTP fallback
MAIL_FROM=DonNation <noreply@donnation.io>
RESEND_API_KEY=
# SMTP (optionnel si RESEND_API_KEY vide)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Stripe Connect
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CRYPTO_PAYMENTS_ENABLED=true

# Blockchain (Anvil local ou Base Sepolia)
BASE_SEPOLIA_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
DON_NATION_PROTOCOL_ADDRESS=
CHAIN_ID=31337
BLOCKCHAIN_CUSTODIAL_WALLET=

# IPFS / storage (optionnel)
PINATA_JWT=
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
